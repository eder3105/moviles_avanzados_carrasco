                            <constraint firstAttribute="trailing" secondItem="DET-NOM" secondAttribute="trailing" constant="16" id="cn-d6"/>
                            <constraint firstItem="DET-DES" firstAttribute="top" secondItem="DET-NOM" secondAttribute="bottom" constant="12" id="cn-d10"/>
                            <constraint firstItem="DET-DES" firstAttribute="leading" secondItem="DET-VIEW" secondAttribute="leading" constant="16" id="cn-d11"/>
                            <constraint firstAttribute="trailing" secondItem="DET-DES" secondAttribute="trailing" constant="16" id="cn-d12"/>
                            <constraint firstItem="DET-SA" firstAttribute="bottom" secondItem="DET-DES" secondAttribute="bottom" constant="8" id="cn-d13"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Detalle" largeTitleDisplayMode="never" id="DET-NAVITEM"/>
                    <connections>
                        <outlet property="imgElemento" destination="DET-IMG" id="ol-d1"/>
                        <outlet property="lblTitulo" destination="DET-NOM" id="ol-d2"/>
                        <outlet property="txtDescripcion" destination="DET-DES" id="ol-d4"/>
